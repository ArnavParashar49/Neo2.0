# NEO's release engine: Python and every package NEO.app's core runs, built once on the build Mac by
# scripts/build_engine.sh, published beside each release, and unpacked by NEO.app into
# ~/Library/Application Support/NEO/engines/<id>. The engine id hashes this file with
# requirements.release.txt and scripts/engine.prune (scripts/engine_id.py): change anything here
# and the next release ships a new engine. Sourced by bash: KEY=value lines, no spaces.

# Bump when build_engine.sh changes what ends up in the engine (not just how it's packed).
ENGINE_RECIPE=1

# The interpreter: python-build-standalone, the build family uv installs (NEO's .venv runs it
# today). install_only_stripped is the variant uv itself downloads; its SHA-256 is the one uv
# 0.12.19 pins for cpython-3.12.14-macos-aarch64-none (its embedded download metadata). The archive
# itself is the base, never uv's installed copy: uv rewrites that one's sysconfig and libpython's
# install name with the build Mac's own paths, and marks it externally managed.
PYTHON_VERSION=3.12.14
PBS_RELEASE=20260924
PBS_ASSET=cpython-3.12.14+20260924-aarch64-apple-darwin-install_only_stripped.tar.gz
PBS_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260924/cpython-3.12.14%2B20260924-aarch64-apple-darwin-install_only_stripped.tar.gz
PBS_SHA256=c2edb321cd32ec2b170df208db0446dccc4398db602ca27cf2079098fb1f7d9d

# The packages' platform: macOS 14 on Apple silicon (torch 2.14 and mlx 0.32 have nothing older),
# so mlx and mlx-metal are their macosx_14_0 wheels even when the build Mac runs a newer macOS.
# The same floor as NEO.app's LSMinimumSystemVersion (ui/src-tauri/tauri.conf.json).
MACOSX_DEPLOYMENT_TARGET=14.0
PYTHON_PLATFORM=aarch64-apple-darwin
ENGINE_PLATFORM=macos14-arm64
