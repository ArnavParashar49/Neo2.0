# Copy to .env for keys and settings — NEO.app's menu → Brains & Keys… does the keys and brains for you.
# One key is enough; Gemini's is free, no card. A key alone sends nothing anywhere new: only a role does.
# (Comments stay on their own lines: after "KEY=" on the same line, one would be read as the key.)
# Google Gemini, free tier — brain, vision and the Live voice: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# More Gemini keys, comma-separated
GEMINI_API_KEYS=
# Groq, free — instant chat replies: https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic (Claude), paid — NEO_BRAIN=claude to use it: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI, paid — NEO_BRAIN=openai to use it: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter, pay as you go — NEO_BRAIN=openrouter@<model>: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cerebras, paid and capped (NEO_CEREBRAS_DAILY_BUDGET) — very fast, tried ahead of Groq: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# An endpoint's own variable, honoured only at its template's host (add the endpoint in Brains & Keys,
# or in NEO_CUSTOM_PROVIDERS): XAI_API_KEY (api.x.ai), DEEPSEEK_API_KEY (api.deepseek.com),
# MISTRAL_API_KEY (api.mistral.ai), TOGETHER_API_KEY (api.together.xyz)

# Brains: each role is <brain>[@<model>], brain one of gemini | gemini_lite | groq | groq_vision |
# cerebras | cerebras_vision | claude (or anthropic) | openai | openrouter | local | custom:<name>.
# Examples: claude@claude-haiku-5-5  openai@gpt-6-luna  openrouter@deepseek/deepseek-v4-pro  custom:ollama@qwen3:14b
# NEO_BRAIN=gemini             the Brain: tasks with tools
# NEO_FAST_BRAIN=groq          Quick replies: chat turns, summaries, memory facts, dictation
# NEO_EYES_BRAIN=              Eyes: steps with a screenshot or photo, and the camera (empty: the Brain if it sees)
# NEO_BACKUP_BRAINS=           up to 4, comma-separated (empty: automatic; none: no backups)
# NEO_LIGHT_BRAIN=gemini_lite  one-step commands the fast path missed (empty: Quick replies' brain)
# NEO_OFFLINE_BRAIN=local
# NEO_CLOUD_EYES=auto          auto | on | off (off: only the brains you named ever see a picture)
# NEO_CLAUDE_MODEL=claude-opus-5   what a bare "claude" means (Brains & Keys sets claude@claude-opus-5-5)
# NEO_OPENAI_MODEL=gpt-6.1-sol
# NEO_OPENROUTER_MODEL=        what a bare "openrouter" means (no default)
# NEO_DAILY_BUDGETS=           dollars a day per provider: anthropic=2,openai=2 (keys saved in Brains & Keys get $2)
# NEO_CUSTOM_PROVIDERS=        OpenAI-compatible endpoints as JSON, e.g.
#   [{"id": "custom:ollama", "label": "Ollama", "template": "ollama", "base_url": "http://localhost:11434/v1", "model": "qwen3:14b"}]

# Everything below is optional too (defaults shown). Prefix NEO_ for any Settings field.
# NEO_VOICE=auto               auto | live | local | off   (with a Gemini key, Gemini Live is the voice whatever the brain)
# NEO_WAKE_WORD=true           false: the microphone is closed while NEO is idle; summon it with ⌥⌘ instead of “Neo”
# NEO_WELLBEING_CHECKINS=false  gentle check-ins: detection stays on-device; with Gemini Live, the check-in line and ~5 s of reply audio go to Gemini
# NEO_WORKFLOW_SUGGESTIONS=true  offer a local spoken shortcut after the same app/site setup succeeds three times
# NEO_WAKE_GATE=shadow        shadow (measure only) | on (no audio to Gemini until you speak after “Neo”) | off
# NEO_MIC_ESCALATE=true       a silent microphone is checked, retried and reported once
# NEO_STUCK_BREAKER=true      a computer-control step that failed twice the same way isn't tried a third time
# NEO_CONTEXT_CAPTURE=true    "this": read the selection / clipboard / front window when your words ask
# NEO_CONTEXT_COPY_FALLBACK=true  a web page's selection Chrome & co. don't share is copied (⌘C), then the clipboard is put back exactly
# NEO_SHORTCUTS=true          your macOS Shortcuts as commands (a model-chosen run asks first)
# NEO_REFLEX=laya              laya | lite | off
# NEO_LOCAL_MODEL=mlx-community/gemma-4-12B-it-4bit
# NEO_CONFIRM_DESTRUCTIVE=true
# NEO_CEREBRAS_DAILY_BUDGET=0.50   dollars a day on Cerebras (0 or off = off); 80% is announced
# NEO_CEREBRAS_MODEL=gpt-oss-120b
# NEO_CEREBRAS_VISION_MODEL=qwen-3.8-27b
# NEO_DATA_DIR=~/.neo
