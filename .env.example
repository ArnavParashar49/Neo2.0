# Copy to .env — both keys are free, no card needed.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (brain + vision + Live voice)
GROQ_API_KEY=              # https://console.groq.com/keys      (optional: instant chat replies)
ANTHROPIC_API_KEY=         # optional paid slot; set NEO_BRAIN=claude to use it

# Everything below is optional (defaults shown). Prefix NEO_ for any Settings field.
# NEO_BRAIN=gemini             gemini | groq | local | claude
# NEO_FAST_BRAIN=groq
# NEO_VOICE=auto               auto | live | local | off
# NEO_REFLEX=laya              laya | lite | off
# NEO_LOCAL_MODEL=mlx-community/gemma-4-12B-it-4bit
# NEO_CONFIRM_DESTRUCTIVE=true
# NEO_DATA_DIR=~/.neo
